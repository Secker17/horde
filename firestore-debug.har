            "mimeType": "text/css",
            "size": 81,
            "text": ":root{font-family:DM Sans,sans-serif;color:#edf1eb;background:#0c1510;font-synthesis:none;--bg:#0c1510;--panel:#132019;--panel2:#17271e;--line:rgba(225,235,224,.12);--muted:#91a096;--cream:#ece8dc;--gold:#d99b43;--green:#769f89}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:var(--bg);color:#edf1eb}button,input,textarea{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit;text-decoration:none}.app-shell{min-height:100vh;overflow:hidden}.site-header{height:76px;padding:0 clamp(22px,5vw,76px);display:flex;align-items:center;justify-content:space-between;position:absolute;z-index:20;width:100%;border-bottom:1px solid rgba(255,255,255,.1)}.brand{display:flex;align-items:center;gap:11px}.brand-mark{width:39px;height:39px;display:grid;place-items:center;border:1px solid rgba(217,155,67,.55);transform:rotate(45deg);background:#0d191280}.brand-mark svg{transform:rotate(-45deg);color:var(--gold)}.brand div:last-child{display:flex;line-height:1;flex-direction:column;gap:3px;letter-spacing:.2em}.brand strong{font:800 15px Manrope}.brand span{font:500 9px Manrope;color:var(--gold);letter-spacing:.42em}.site-header nav{display:flex;gap:36px}.site-header nav a{font-size:13px;color:#c2ccc5;transition:.2s}.site-header nav a:hover{color:#fff}.header-actions{display:flex;align-items:center;gap:10px}.admin-button{border:1px solid rgba(255,255,255,.18);background:#0a140e75;color:#dce5df;border-radius:99px;padding:9px 14px;display:flex;align-items:center;gap:7px;cursor:pointer;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}.admin-button:hover,.admin-button.active{border-color:#d99b43a6;color:#fff}.menu-button{display:none;background:none;border:0;color:#fff}.hero{height:min(850px,94vh);min-height:670px;position:relative;display:flex;align-items:center;padding:90px clamp(24px,8vw,130px) 40px}.hero-image{position:absolute;top:0;right:0;bottom:0;left:0;background:url(/assets/horde-natu