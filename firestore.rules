rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "QxVrDWjUPSV6Z8MlDqaYsivC74V2";
    }

    match /mapStatuses/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'authorUid', 'message', 'area', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.authorUid is string
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 600
        && request.resource.data.area is string;
      allow update, delete: if isAdmin();
    }

    match /verifiedUsers/{userKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /presence/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
